NODE_ENV=production
FRONTEND_URL=https://staging-crm.example.com
SUPABASE_URL=https://replace-SEPARATE-staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-private-service-role-key
ACCOUNTS_PIN_PEPPER=replace-with-at-least-32-random-characters
WEBHOOK_SECRET=replace-with-at-least-32-random-characters
