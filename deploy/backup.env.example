# Separate private /etc/hd-crm/backup.env; mode 0600; never expose to the client.
# Use Supabase Connect: direct or session port 5432, percent-encode the password.
SUPABASE_DB_URL=postgresql://postgres:replace-password@db.example.supabase.co:5432/postgres?sslmode=verify-full
# Download the project's trusted CA certificate for verify-full.
PGSSLROOTCERT=/etc/hd-crm/supabase-ca.crt
BACKUP_AGE_RECIPIENT=age1replace-with-public-recipient
BACKUP_DIR=/var/backups/hd-crm
