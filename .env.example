# Copy to root .env; never commit secrets. Client also needs client/.env.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Required in production: private random secret (32+ characters) for PIN hashing.
# Development only: service-key fallback. Changing it requires admins to reset PINs.
ACCOUNTS_PIN_PEPPER=
# Confirmation email redirects use FRONTEND_URL/login. Allow it in Supabase Auth.
# Use an explicit HTTPS CRM address in production. SMTP is configured in Supabase.
FRONTEND_URL=http://localhost:5173
PORT=3001
TRUST_PROXY=loopback
NODE_ENV=development
# Admins sign in with email/password. Agents may opt in at Auth level.
# Set true to require TOTP enrollment/verification for every agent as well.
REQUIRE_AGENT_MFA=false
# Legacy admin invitation expiry and exact-domain blocklist (no mailbox enumeration).
# Historical 033/034 native codes use a 600-second native expiry.
# New independent creation challenges use server settings documented below.
# Free Gmail SMTP setup: docs/AGENT_EMAIL_CODES.md. Configure credentials only in Supabase.
CRM_INVITATION_TTL_MINUTES=60
CRM_BLOCKED_EMAIL_DOMAINS=
CALL_PROVIDER=mock
WEBHOOK_SECRET=
OUTCOME_GRACE_MINUTES=30
RECORDING_RETENTION_DAYS=7
JOB_INTERVAL_SECONDS=60
# Distinct customer numbers an agent may reveal per Pakistan day (1–10000).
# Admin reveals are audited and recorded but have no daily limit.
# Historical reveal-status endpoint only; automatic contact display has no daily quota.
PHONE_REVEAL_DAILY_LIMIT=80
# Sign-in lockout and login history (update 037). Defaults shown; all optional.
# LOGIN_MAX_ATTEMPTS wrong passwords within LOGIN_WINDOW_MINUTES lock the email
# for LOGIN_LOCK_MINUTES. LOGIN_BUSINESS_HOURS is Pakistan time start-end; a
# sign-in outside it raises a security alert.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
LOGIN_BUSINESS_HOURS=08-21
# API rate limits (docs/RATE_LIMITS.md). Defaults shown; all optional; each is
# a whole number from 1 to 100000 (limiting cannot be switched off).
# Signed-in requests are counted per verified user, so an office sharing one
# IP is not limited together. Requests per window:
# - per user: all requests (15 min), changes and private data (1 min), heavy
#   reports and dashboards, exports, imports, account creation, PIN and email
#   codes, authenticator codes (15 min each);
# - per invited user: invitation set-up (15 min);
# - per client IP: requests that fail sign-in checks, sign-in and invitation
#   routes, refused sign-ins, password reset requests (15 min each), provider
#   callbacks and Meta webhooks (1 min each).
RATE_LIMIT_USER_PER_15_MIN=1000
RATE_LIMIT_SENSITIVE_PER_MIN=30
RATE_LIMIT_REPORTS_PER_15_MIN=300
RATE_LIMIT_EXPORTS_PER_15_MIN=30
RATE_LIMIT_IMPORTS_PER_15_MIN=30
RATE_LIMIT_ACCOUNT_CREATION_PER_15_MIN=20
RATE_LIMIT_ACCOUNT_SECURITY_PER_15_MIN=10
RATE_LIMIT_MFA_VERIFY_PER_15_MIN=10
RATE_LIMIT_ONBOARDING_PER_15_MIN=20
RATE_LIMIT_UNAUTHENTICATED_PER_15_MIN=300
RATE_LIMIT_PUBLIC_PER_15_MIN=300
RATE_LIMIT_LOGIN_FAILURES_PER_15_MIN=30
RATE_LIMIT_PASSWORD_RESET_PER_15_MIN=5
RATE_LIMIT_CALLBACKS_PER_MIN=30
RATE_LIMIT_META_WEBHOOK_PER_MIN=1200
# These belong in client/.env; no server secrets there.
# VITE_IDLE_TIMEOUT_MINUTES (optional, default 30) signs out idle browsers.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_API_URL=/api
# Development setup requires explicit passwords, no defaults.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_AGENT_EMAIL=
DEV_AGENT_PASSWORD=
# Optional Facebook/Instagram Instant Forms integration (server only).
# Leave blank until the Meta app, approved Business Login configuration and HTTPS CRM are ready.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Select a currently supported version in the Meta App Dashboard, for example vNN.0.
META_GRAPH_VERSION=
META_OAUTH_REDIRECT_URL=
# Webhook address is the public CRM origin + /api/integrations/meta/webhook.
META_WEBHOOK_VERIFY_TOKEN=
# 32 random bytes encoded as 64 hex characters; keep stable and back it up securely.
META_TOKEN_ENCRYPTION_KEY=
# Private form answers/normalized review data expire after 1–90 days.
META_ANSWER_RETENTION_DAYS=30

# Deleted leads can be restored for 30 days; SQL purges up to 200 expired leads daily.
LEAD_DELETE_RETENTION_DAYS=30

# Optional since update 036: new accounts are created directly (Gmail + UID), no email code.
# Keep the settings below only to finish email-code requests started before 036.
# Independent account-creation OTP (035). Server-only, never VITE_/NEXT_PUBLIC_.
# Generate once with node -e 'process.stdout.write(require("crypto").randomBytes(32).toString("hex"))'
ACCOUNT_OTP_SECRET=
# Choose smtp (e.g. eligible Gmail + App Password) OR resend.
ACCOUNT_EMAIL_PROVIDER=smtp
# Address only, without a display name; must match your authorized sender.
ACCOUNT_EMAIL_FROM=
ACCOUNT_SMTP_HOST=smtp.gmail.com
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_USER=
ACCOUNT_SMTP_PASSWORD=
# Used only when ACCOUNT_EMAIL_PROVIDER=resend; a verified sending domain is required.
RESEND_API_KEY=
